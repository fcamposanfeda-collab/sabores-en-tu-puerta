# Configuración para hosting Apache (la mayoría de hostings compartidos en España).
# Se copia sola a out/ al hacer `npm run build`. Sube el contenido de out/ a la raíz pública (public_html).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Fuerza HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Quita www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # URL antigua
  RewriteRule ^servicios/eventos/?$ /servicios/catering-personalizado/ [L,R=301]
</IfModule>

# Imágenes generadas sin extensión (favicon y Open Graph)
<FilesMatch "^(icon|opengraph-image)$">
  ForceType image/png
</FilesMatch>

<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
  AddCharset utf-8 .html .txt .xml .css .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Los archivos de _next/static llevan hash en el nombre y no cambian nunca
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
